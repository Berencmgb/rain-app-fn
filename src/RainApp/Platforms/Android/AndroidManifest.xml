<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
	<!-- No INTERNET permission: the app is fully offline (spec: nothing leaves the
	     device). Only the media notification's permission is declared. -->
	<!-- Media notification for the playback foreground service (ADR-0001, #7):
	     runtime request on first play (Android 13+), which never blocks playback. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>